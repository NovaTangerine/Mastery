rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: games
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - platform: string (optional)
    //   - status: string (required, enum: ['playing', 'completed', 'backlog', 'abandoned'])
    //   - coverUrl: string (optional)
    //   - overallNotes: string (optional)
    //   - storySynopsis: string (optional)
    //   - uid: string (required)
    //   - createdAt: number (required)
    //   - updatedAt: number (required)
    //
    // Collection: sessions
    // Document ID: auto-generated
    // Fields:
    //   - gameId: string (required)
    //   - uid: string (required)
    //   - startTime: number (required)
    //   - endTime: number (optional)
    //   - progressMarker: string (required)
    //
    // Collection: notes
    // Document ID: auto-generated
    // Fields:
    //   - gameId: string (required)
    //   - sessionId: string (optional)
    //   - uid: string (required)
    //   - content: string (required)
    //   - tags: list (optional)
    //   - isGlobal: bool (optional)
    //   - timestamp: number (required)
    //   - order: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "kyledk05@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidGame(data) {
      return hasOnlyAllowedFields(['title', 'platform', 'status', 'coverUrl', 'overallNotes', 'storySynopsis', 'uid', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ['playing', 'completed', 'backlog', 'abandoned'] &&
             data.uid is string &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('platform' in data) || data.platform == null || (data.platform is string && data.platform.size() < 100)) &&
             (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() < 2000)) &&
             (!('overallNotes' in data) || data.overallNotes == null || (data.overallNotes is string && data.overallNotes.size() < 10000)) &&
             (!('storySynopsis' in data) || data.storySynopsis == null || (data.storySynopsis is string && data.storySynopsis.size() < 10000));
    }

    function isValidSession(data) {
      return hasOnlyAllowedFields(['gameId', 'uid', 'startTime', 'endTime', 'progressMarker', 'name', 'chapter', 'hoursPlayed', 'groupId', 'trackers', 'metrics']) &&
             data.gameId is string &&
             data.uid is string &&
             data.startTime is number &&
             data.progressMarker is string && data.progressMarker.size() < 100 &&
             (!('endTime' in data) || data.endTime == null || data.endTime is number) &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() < 100)) &&
             (!('chapter' in data) || data.chapter == null || (data.chapter is string && data.chapter.size() < 100)) &&
             (!('hoursPlayed' in data) || data.hoursPlayed == null || (data.hoursPlayed is number && data.hoursPlayed >= 0)) &&
             (!('groupId' in data) || data.groupId == null || (data.groupId is string && data.groupId.size() < 100)) &&
             (!('trackers' in data) || data.trackers == null || (data.trackers is list && data.trackers.size() <= 50)) &&
             (!('metrics' in data) || data.metrics == null || (data.metrics is list && data.metrics.size() <= 50));
    }

    function isValidSessionGroup(data) {
      return hasOnlyAllowedFields(['gameId', 'uid', 'title', 'createdAt', 'order']) &&
             data.gameId is string &&
             data.uid is string &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.createdAt is number &&
             data.order is string;
    }

    function isValidNote(data) {
      return hasOnlyAllowedFields(['gameId', 'sessionId', 'uid', 'content', 'tags', 'isGlobal', 'timestamp', 'order']) &&
             data.gameId is string &&
             data.uid is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.timestamp is number &&
             (!('order' in data) || data.order == null || data.order is string) &&
             (!('sessionId' in data) || data.sessionId == null || (data.sessionId is string && data.sessionId.size() < 100)) &&
             (!('isGlobal' in data) || data.isGlobal == null || data.isGlobal is bool) &&
             (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 20));
    }

    function isValidDraft(data) {
      return hasOnlyAllowedFields(['gameId', 'sessionId', 'uid', 'content', 'tags', 'updatedAt']) &&
             data.gameId is string &&
             data.uid is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.updatedAt is number &&
             (!('sessionId' in data) || data.sessionId == null || (data.sessionId is string && data.sessionId.size() < 100)) &&
             (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 20));
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /drafts/{draftId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidDraft(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidDraft(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['uid', 'gameId', 'sessionId']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /games/{gameId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidGame(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidGame(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['uid', 'createdAt']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidSession(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidSession(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['uid', 'gameId', 'startTime']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /sessionGroups/{groupId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidSessionGroup(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidSessionGroup(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['uid', 'gameId', 'createdAt']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidNote(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidNote(request.resource.data) && uidNotModified() && areImmutableFieldsUnchanged(['uid', 'gameId', 'timestamp']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
    }

    match /api_usage/{usageId} {
      allow read, write: if false; // Only backend can write to this collection
    }
  }
}
