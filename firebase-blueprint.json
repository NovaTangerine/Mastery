{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "A video game being tracked by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "platform": { "type": "string" },
        "status": { "type": "string", "enum": ["playing", "completed", "backlog", "abandoned"] },
        "coverUrl": { "type": "string" },
        "overallNotes": { "type": "string" },
        "storySynopsis": { "type": "string" },
        "uid": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "status", "uid", "createdAt", "updatedAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "A specific play session for a game.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "uid": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "progressMarker": { "type": "string" },
        "name": { "type": "string" },
        "chapter": { "type": "string" },
        "hoursPlayed": { "type": "number" }
      },
      "required": ["gameId", "uid", "startTime", "progressMarker"]
    },
    "Note": {
      "title": "Note",
      "description": "A single note or observation about a game.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "isGlobal": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["gameId", "uid", "content", "timestamp"]
    },
    "Draft": {
      "title": "Draft",
      "description": "An unfinished note saved for later.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["gameId", "uid", "content", "updatedAt"]
    },
    "SessionGroup": {
      "title": "SessionGroup",
      "description": "A group of game sessions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "order": { "type": "string" }
      },
      "required": ["gameId", "uid", "title", "createdAt", "order"]
    },
    "ApiUsage": {
      "title": "ApiUsage",
      "description": "Tracks Gemini API token usage per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "timestamp": { "type": "number" },
        "promptTokenCount": { "type": "number" },
        "candidatesTokenCount": { "type": "number" },
        "totalTokenCount": { "type": "number" }
      },
      "required": ["uid", "timestamp", "promptTokenCount", "candidatesTokenCount", "totalTokenCount"]
    }
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": "Game",
      "description": "User's games."
    },
    "/sessionGroups/{groupId}": {
      "schema": "SessionGroup",
      "description": "Groups of game sessions."
    },
    "/sessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Game sessions."
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Individual notes."
    },
    "/drafts/{draftId}": {
      "schema": "Draft",
      "description": "Unfinished notes."
    },
    "/api_usage/{usageId}": {
      "schema": "ApiUsage",
      "description": "API usage tracking."
    }
  }
}
